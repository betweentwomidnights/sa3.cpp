# Reference clones (large, fetch separately)
refs/

# Build artifacts
build/
build-cpu/
build-cpu-variants/
build-cuda/
build-vulkan/
build-hip/
build-metal/
build-all/
*.o
*.obj
*.exe

# Reference activation dumps (regenerate via tools/dump_refs.py) + C++ checkpoint dumps
refdata*/
cppout*/
refstep*/
bench/

# Local audio output + stale run markers
*.wav
*.log.started

# LoRA/DoRA adapter checkpoints + exports (large; convert to gguf via sa3-lora-convert / convert_lora.py)
loras/*
!loras/README.md

# Model weights / checkpoints (*.norms = derived base-norm cache, regenerated on demand)
models/*
!models/README.md
checkpoints/
train-runs/
*.gguf
*.norms
*.safetensors
metrics.jsonl
config.snapshot.txt
command.txt

# Python
__pycache__/
*.pyc
.venv/
_smallweights/
_sfxweights/

# local config (use .env.example as a template)
.env

# generated by build.sh/.cmd (machine-specific PATH helpers)
env.sh
env.cmd
env.ps1

# Ableton analysis sidecars, written next to any wav a DAW has opened
*.asd

# Personal prompt dice pools. defaults.json plus two adapter pools ship as examples;
# everything else in here is local.
prompts/*.json
!prompts/defaults.json
!prompts/kev.json
!prompts/keygen.json
